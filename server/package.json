{
  "name": "messenger-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run build && node --test dist/*.test.js",
    "prisma:generate": "node scripts/prisma-with-env.cjs generate",
    "prisma:migrate": "node scripts/prisma-with-env.cjs migrate dev",
    "prisma:deploy": "node scripts/prisma-with-env.cjs migrate deploy",
    "prisma:studio": "node scripts/prisma-with-env.cjs studio",
    "meetvap:ensure-system": "node scripts/ensure-meetvap-system-account.cjs"
  },
  "dependencies": {
    "@parse/node-apn": "^8.1.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "cbor": "^10.0.12",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.1",
    "morgan": "^1.12.1",
    "node-app-attest": "^1.0.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.11.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
