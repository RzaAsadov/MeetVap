map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream meetvap_server {
  server server:4000;
  keepalive 32;
}

upstream meetvap_admin {
  server admin:4300;
  keepalive 8;
}

upstream meetvap_livekit {
  server livekit:7880;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name __WEB_DOMAIN__ __MEET_DOMAIN__ __SERVER_DOMAIN__ __ADMIN_DOMAIN__;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location = /nginx-health {
    access_log off;
    return 200 'ok';
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __WEB_DOMAIN__;

  ssl_certificate /etc/letsencrypt/live/meetvap/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/meetvap/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /srv/web;

  location = /runtime-config.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    expires -1;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __MEET_DOMAIN__;

  ssl_certificate /etc/letsencrypt/live/meetvap/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/meetvap/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /srv/meet;

  location = /runtime-config.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    expires -1;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __ADMIN_DOMAIN__;

  ssl_certificate /etc/letsencrypt/live/meetvap/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/meetvap/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 1100m;

  location / {
    proxy_pass http://meetvap_admin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __SERVER_DOMAIN__;

  ssl_certificate /etc/letsencrypt/live/meetvap/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/meetvap/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 1100m;

  location ^~ /rtc {
    proxy_pass http://meetvap_livekit;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ^~ /socket.io/ {
    proxy_pass http://meetvap_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 3600s;
  }

  location ^~ /media/ {
    proxy_pass http://meetvap_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }

  location / {
    proxy_pass http://meetvap_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 300s;
  }
}
